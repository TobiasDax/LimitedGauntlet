# Postgres credentials used by both the db and app services.
POSTGRES_USER=limitedgauntlet
POSTGRES_PASSWORD=changeme
POSTGRES_DB=limitedgauntlet

# Port the app is published on (host side).
PORT=8080

# Session cookie signing key — 32 bytes, hex-encoded. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Set to "true" once a TLS-terminating reverse proxy is in front of this
# app (marks the session cookie Secure, so it's dropped over plain HTTP).
# Leave false for local/LAN-only use.
SESSION_COOKIE_SECURE=false

# Closed by default — this app is meant for an existing group, not a public
# signup form. Set to "true" only while someone actually needs to create an
# account, then set it back to "false" (requires a restart either way:
# `docker compose up -d` picks up the new value).
ALLOW_SIGNUP=false

# Only used by `npm run dev:server` (hot-reload local dev, outside Docker).
# `docker compose up` ignores this entirely — it computes its own
# DATABASE_URL pointing at the `db` service over the internal compose
# network. This one targets `docker compose up -d db`'s Postgres via its
# published host port instead, so keep the credentials in sync with
# POSTGRES_USER/PASSWORD/DB above if you change them.
DATABASE_URL=postgres://limitedgauntlet:changeme@localhost:5432/limitedgauntlet
