# Postgres credentials used by both the db and app services.
POSTGRES_USER=limitedgauntlet
POSTGRES_PASSWORD=changeme
POSTGRES_DB=limitedgauntlet

# Comma-separated exact proxy IPs/CIDRs allowed to set X-Forwarded-* identity.
# Leave blank for direct/LAN mode (no reverse proxy or tunnel in front). If you
# put a reverse proxy or tunnel (Cloudflare Tunnel, Nginx, Caddy, Traefik, ...)
# in front, set this to its exact container IP/CIDR on the network it shares
# with the app — see docs/deployment.md section 4. Never use a broad
# Docker/private-network CIDR.
TRUSTED_PROXIES=

# Session cookie signing key — 32 bytes, hex-encoded. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Set to "true" once a TLS-terminating reverse proxy is in front of this
# app (marks the session cookie Secure, so it's dropped over plain HTTP).
# Leave false for local/LAN-only use.
SESSION_COOKIE_SECURE=false

# Closed by default — this app is meant for an existing group, not a public
# signup form. Set to "true" only while someone actually needs to create an
# account, then set it back to "false" (requires a restart either way:
# `docker compose up -d` picks up the new value).
ALLOW_SIGNUP=false

# Public base URL the app is reached at (e.g. https://gauntlet.example.com).
# Used to build absolute links in emails. If empty, the app derives it from the
# request origin — fine for most setups; set it if you send mail from behind a
# proxy that rewrites the host.
APP_BASE_URL=

# Optional SMTP for transactional email (currently: verifying an organizer's
# new email address before switching to it). Entirely optional — leave SMTP_HOST
# empty and email features stay disabled (email changes just aren't offered)
# without affecting the rest of the app. SMTP_FROM is the From: address.
# SMTP_SECURE=true means implicit TLS (port 465); false means STARTTLS (587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional footer legal link (e.g. Impressum/Privacy Policy). This is
# self-hosted OSS with no built-in legal content — if your jurisdiction
# requires one, host it yourself and point these at it. Leave both empty
# to omit the link entirely (footer still shows GitHub + License).
LEGAL_LINK_URL=
LEGAL_LINK_LABEL=

# Optional OIDC / SSO login (single identity provider per deployment).
# Entirely optional: leave OIDC_ISSUER empty and the app runs password-only
# (the "Sign in with…" button just isn't shown). When set, an SSO login links
# to an existing organizer account by verified email, or provisions one if the
# email has a pending co-organizer invite — it never creates a new org, so the
# closed-signup posture is preserved. OIDC_ISSUER is the provider's base URL
# (discovery must be reachable at <issuer>/.well-known/openid-configuration).
# Register OIDC_REDIRECT_URI at the provider as <APP_BASE_URL>/api/auth/oidc/callback
# (leave it blank to derive that automatically from APP_BASE_URL).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_PROVIDER_NAME=SSO
OIDC_SCOPE=openid email profile

# Optional social login (PI-43), on the same account-linking rules as OIDC
# above. Each is independent — set both id + secret to show that button.
# Google: create an OAuth "Web application" client in Google Cloud Console,
#   authorized redirect URI <APP_BASE_URL>/api/auth/sso/google/callback
# Discord: create an app in the Discord Developer Portal, add an OAuth2 redirect
#   <APP_BASE_URL>/api/auth/sso/discord/callback (scopes identify + email).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Switch to SSO-only: disable local password login + local signup so an SSO
# provider is the only way in. Only takes effect when at least one SSO provider
# above is configured (a fail-safe so you can't lock yourself out). New users
# signing in via SSO for the first time get an org-setup screen (when
# ALLOW_SIGNUP=true); existing/invited accounts keep working. Leave false to
# keep local email+password accounts alongside SSO.
LOCAL_LOGIN_DISABLED=false

# Optional deployer-configured web analytics (currently Umami only). Entirely
# optional — leave TRACKING_PROVIDER empty and no tracking script is ever
# added to any page. Set all three to enable: TRACKING_SCRIPT_URL is your own
# Umami instance's script host (e.g. https://analytics.example.com/script.js),
# TRACKING_CODE is that site's website UUID (Umami → Settings → Websites).
# Both are strictly validated at startup (script URL must be https://, code
# must look like a UUID) — a bad value refuses to start rather than silently
# running unvalidated script. The app proxies the script + collect endpoint
# same-origin (GET /stats.js), so the browser never talks to
# TRACKING_SCRIPT_URL directly and the CSP never needs widening for it.
# See docs/deployment.md section 10.
TRACKING_PROVIDER=
TRACKING_SCRIPT_URL=
TRACKING_CODE=

# Optional operator alert on a new org signup (only relevant with
# ALLOW_SIGNUP=true). Entirely optional — leave ADMIN_WEBHOOK_URL empty and
# nothing fires. An HMAC-signed HTTP POST (same scheme as the per-org
# webhooks in Settings — X-LimitedGauntlet-Signature), receiver-agnostic:
# point it at your own Home Assistant, Discord, ntfy, whatever. http:// is
# allowed (not just https://) since the real target is often a plain-http
# LAN/Tailscale receiver. ADMIN_WEBHOOK_SECRET must be at least 16
# characters. See docs/deployment.md section 11.
ADMIN_WEBHOOK_URL=
ADMIN_WEBHOOK_SECRET=

# Only used by `npm run dev:server` (hot-reload local dev, outside Docker).
# `docker compose up` ignores this entirely — it computes its own
# DATABASE_URL pointing at the `db` service over the internal compose
# network. This one targets `docker compose up -d db`'s Postgres via a
# host port instead — but `db` publishes no host port by default (nothing
# outside Docker should reach Postgres in a normal deployment), so local
# dev needs one added back via a docker-compose.override.yml:
#   services:
#     db:
#       ports:
#         - "5432:5432"
# Keep the credentials here in sync with POSTGRES_USER/PASSWORD/DB above
# if you change them.
DATABASE_URL=postgres://limitedgauntlet:changeme@localhost:5432/limitedgauntlet
