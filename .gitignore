.DS_Store

# Per-deployment Compose customization (network wiring, reverse-proxy
# labels, etc.) — deliberately local-only, same reasoning as .env. Docker
# Compose auto-merges this alongside docker-compose.yml with no flag
# needed, so a deployment's local setup survives `git pull` without ever
# touching the tracked file.
docker-compose.override.yml

# Real historical tournament data (names, results) for whoever's running
# their own LimitedGauntlet instance -- never belongs in git history, even
# on a private remote. See README's "History import" section.
/legacy-data*.json
/legacy-data*.json.bak
# The transcribed round-by-round history (real names + results) that feeds the
# import. Pure-logic helpers (build-/validate-/verify-*) stay committable.
/scripts/rounds-data.mjs
