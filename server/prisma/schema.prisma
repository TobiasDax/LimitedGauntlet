// LimitedGauntlet data model — see PLAN.md for the full design rationale
// behind each entity before changing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // Optional password lock for the public pages (PI-27). Null = public pages
  // are open (the default). When set (argon2 hash), a visitor must enter the
  // password once to view any /o/<slug>/... page — an opt-in, off-by-default
  // exception to "public pages stay open", set only by the organizer.
  publicPasswordHash String?
  createdAt DateTime @default(now())

  organizers  OrganizerAccount[]
  players     Player[]
  tournaments Tournament[]
  organizerInvites OrganizerInvite[]
  webhooks    OrganizationWebhook[]
}

// Outbound webhooks (PI-50): an HMAC-signed HTTP POST fired on round
// lifecycle events (round started/extended/completed, pairings posted) so an
// organizer's own automation (Home Assistant, etc.) can react — the receiver
// derives a live countdown from the endsAt each payload carries, so this
// never needs to stream continuously. An org can configure any number of
// these, each delivered independently with its own secret (revised 2026-08-26
// from a single url/secret pair on Organization, per Tobias — push the same
// events to multiple places at once). No rows = inert for this org, same
// "degrades cleanly when unconfigured" posture as SMTP/OIDC.
model OrganizationWebhook {
  id    String  @id @default(cuid())
  orgId String
  url   String
  // Intentionally NOT a one-way hash: unlike a password or API token
  // (something a caller presents that we only ever need to verify), this app
  // is the one PRESENTING this, as the HMAC key that signs every outgoing
  // request, so it has to remain readable to the server.
  secret String
  // Optional organizer-facing name ("Home Assistant", "Discord relay") to
  // tell multiple webhooks apart in Settings — purely cosmetic.
  label     String?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrganizerAccount {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  // Nullable since PI-42: an account provisioned purely via OIDC (SSO) has no
  // local password. Password login is rejected for such accounts; they can set
  // a password later from Settings to gain a second way in.
  passwordHash String?
  // OIDC subject (`sub` claim) of the linked identity-provider account (PI-42).
  // Set the first time an OIDC login links to (or provisions) this account, so
  // subsequent logins match on the stable subject even if the IdP email later
  // changes. One IdP per deployment (issuer is env-configured), so the subject
  // alone is unique. Null for password-only accounts.
  oidcSubject  String?  @unique
  authVersion  Int      @default(0)
  name         String
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiTokens    ApiToken[]
  emailChangeRequests EmailChangeRequest[]
  oidcRelinkRequests OidcSubjectRelinkRequest[]
  sentInvites  OrganizerInvite[]

  @@index([orgId])
}

model OidcSubjectRelinkRequest {
  id             String    @id @default(cuid())
  organizerId    String
  pendingSubject String
  email          String
  purpose        String    @default("SUBJECT_RELINK")
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organizer OrganizerAccount @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
}

// Pending co-organizer invites (PI-34). An invited address doesn't get an
// account until they open the emailed link and set their own name/password
// (accept-invite) — the same "possession of the link proves the address"
// pattern as EmailChangeRequest, just scoped to the org rather than an
// existing organizer. Roles are equal for v1: an accepted invite creates a
// full OrganizerAccount, same access as anyone else in the org.
model OrganizerInvite {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    OrganizerAccount @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Pending email-address changes (PI-28). A change is only applied after the
// organizer clicks a link sent to the NEW address, proving they control it.
// Only the token's SHA-256 hash is stored (same as ApiToken); single-use
// (usedAt) and time-limited (expiresAt).
model EmailChangeRequest {
  id          String    @id @default(cuid())
  organizerId String
  newEmail    String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  organizer OrganizerAccount @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
}

// Bearer tokens for non-browser clients (e.g. the MCP server) — acts as
// the minting organizer, identical blast radius to them being logged in,
// no more. Only the hash is stored; the plaintext is shown once at mint
// time and never again.
model ApiToken {
  id          String    @id @default(cuid())
  organizerId String
  name        String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  organizer OrganizerAccount @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
}

// ---------------------------------------------------------------------------
// Roster
// ---------------------------------------------------------------------------

model Player {
  id          String   @id @default(cuid())
  orgId       String
  displayName String
  createdAt   DateTime @default(now())

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tournamentPlayers TournamentPlayer[]
  teamMemberships   TeamMember[]
  entrants          Entrant[]
  cardPulls         CardPull[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Tournament (one yearly weekend / GP)
// ---------------------------------------------------------------------------

enum TournamentStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

model Tournament {
  id        String           @id @default(cuid())
  orgId     String
  name      String
  startDate DateTime
  endDate   DateTime
  location  String?
  // Free-text blurb shown on the tournament page + its public link. May
  // contain URLs / [label](url) links (e.g. to Outline pages); rendered
  // safely as text-plus-links on the client, never as raw HTML.
  description String?
  status    TournamentStatus @default(PLANNING)
  createdAt DateTime         @default(now())

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  players      TournamentPlayer[]
  pods         Pod[]

  @@index([orgId])
}

model TournamentPlayer {
  tournamentId String
  playerId     String

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([tournamentId, playerId])
}

// ---------------------------------------------------------------------------
// Pod (one session: Freitag, Samstag 1, Chaosdraft, ...)
// ---------------------------------------------------------------------------

enum PodFormat {
  DRAFT
  SEALED
  CHAOS_DRAFT
  CONSTRUCTED
  CUSTOM
}

enum ConstructedFormat {
  STANDARD
  MODERN
  LEGACY
  VINTAGE
  PIONEER
  PRE_MODERN
  PAUPER
  CUSTOM
}

enum MatchFormat {
  BO1
  BO3
}

enum PodStatus {
  SETUP
  PAIRING
  IN_PROGRESS
  COMPLETED
}

model Pod {
  id                 String      @id @default(cuid())
  tournamentId       String
  name               String
  date               DateTime?
  format             PodFormat
  // Default Scryfall set code for this pod's card pulls (e.g. "eoe") —
  // pre-fills the add-pull form's set picker so a whole draft/sealed pod's
  // worth of pulls don't each need the set typed in by hand. Purely a
  // frontend convenience; never used server-side to resolve a pull, and
  // always overridable per pull (e.g. a bonus-sheet card from a linked
  // companion set).
  setCode            String?
  // Which constructed format was played — only meaningful when
  // format === CONSTRUCTED. CUSTOM pairs with constructedFormatCustom
  // for a free-text name (e.g. "Canadian Highlander"); application-layer
  // enforced, same pattern as setCode above.
  constructedFormat       ConstructedFormat?
  constructedFormatCustom String?
  sequenceOrder           Int
  isTeamEvent        Boolean     @default(false)
  teamSize           Int?
  roundCount         Int         @default(3)
  matchFormat        MatchFormat @default(BO3)
  pointsWin          Int         @default(3)
  pointsDraw         Int         @default(1)
  pointsLoss         Int         @default(0)
  roundLengthMinutes Int         @default(50)
  packConfig         String?
  rarepicUrl         String?
  status             PodStatus   @default(SETUP)
  excludeFromStats   Boolean     @default(false)
  // Per-pod opt-out for the org's webhook (PI-50) — default on, mirrors
  // excludeFromStats's opt-out shape (an organizer turns individual noisy/
  // test pods off, rather than needing to opt each real pod in).
  webhookEnabled     Boolean     @default(true)
  // At most one pod per tournament may be the "main event" (Chaos Draft
  // for this group, but deliberately generic — any format works). Winning
  // one earns a crown on the Hall of Fame. Application-layer enforcement
  // (podRoutes unsets any sibling in a transaction before setting this)
  // plus a DB-level partial unique index (see the migration) as the real
  // guarantee — the app-layer check alone can't rule out a race.
  isMainEvent        Boolean     @default(false)
  // Standalone pre-round timer (PI-33) for draft / deck-building time, before
  // any round is paired. `prepTimerEndsAt` is when it expires (null = no timer
  // running); `prepTimerLabel` is an optional caption ("Draft", "Deck-building").
  // Independent of the per-round timer (Round.endsAt) — a pod can run this with
  // zero rounds. Only the end time is stored; the countdown ticks client-side.
  prepTimerEndsAt    DateTime?
  prepTimerLabel     String?
  createdAt          DateTime    @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams      Team[]
  entrants   Entrant[]
  rounds     Round[]
  cardPulls  CardPull[]

  @@index([tournamentId])
}

model Team {
  id    String @id @default(cuid())
  podId String
  name  String

  pod     Pod          @relation(fields: [podId], references: [id], onDelete: Cascade)
  members TeamMember[]
  entrant Entrant?

  @@index([podId])
}

model TeamMember {
  teamId   String
  playerId String

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
}

// Entrant unifies individual players and ad-hoc teams as "the thing that
// gets paired" so standings/pairing logic doesn't need separate code paths
// for 1v1 vs team pods. Exactly one of playerId/teamId is set, matching
// Pod.isTeamEvent — enforced at the application layer (Prisma has no
// portable CHECK-constraint-style XOR).
model Entrant {
  id                  String  @id @default(cuid())
  podId               String
  playerId            String?
  teamId              String? @unique
  droppedAfterRound   Int?
  // Set only by the history-import script, for pods whose source data is a
  // final standings table with no round-by-round detail (most pre-2026
  // Outline docs). When present, standings computation reports this value
  // directly instead of deriving points from Match rows — deliberately not
  // fabricating pairings that were never recorded. Tiebreakers (OMW%/GW%/
  // OGW%) report as 0 for these entrants since no match data exists to
  // compute them from.
  finalPointsOverride Int?
  // Manual tiebreak order, only ever compared between entrants who are
  // ALREADY tied on points — never overrides points itself. Exists for the
  // "intentional draw to lock in placement" case: two players draw their
  // final match on purpose (e.g. 2W-1D = 7 points, safely clear of 3rd
  // place's 6), and the computed OMW%/GW%/OGW% tiebreakers among a small
  // pod don't necessarily reflect what the group actually decided —
  // sometimes there's nothing to compute a "real" order from at all. Lower
  // sorts first. Set via the standings page's reorder-within-a-tie UI.
  manualTiebreak      Int?

  pod        Pod     @relation(fields: [podId], references: [id], onDelete: Cascade)
  player     Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team       Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchesAsA Match[] @relation("MatchEntrantA")
  matchesAsB Match[] @relation("MatchEntrantB")

  @@index([podId])
  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Rounds & matches
// ---------------------------------------------------------------------------

enum RoundStatus {
  PENDING
  ACTIVE
  COMPLETED
}

model Round {
  id          String      @id @default(cuid())
  podId       String
  roundNumber Int
  startedAt   DateTime?
  endsAt      DateTime?
  status      RoundStatus @default(PENDING)

  pod     Pod     @relation(fields: [podId], references: [id], onDelete: Cascade)
  matches Match[]

  @@unique([podId, roundNumber])
}

enum MatchResult {
  PENDING
  A_WINS
  B_WINS
  DRAW
}

model Match {
  id          String      @id @default(cuid())
  roundId     String
  tableNumber Int
  entrantAId  String
  entrantBId  String? // null = bye
  gamesWonA   Int         @default(0)
  gamesWonB   Int         @default(0)
  // Games that were themselves drawn (e.g. a Bo3 that ends 1-1-1, or a
  // single game timing out unfinished). Not credited to either side, but
  // counted as games played — so game-win% is diluted the way the MTR/
  // larger-tournament rules intend. A match DRAW is still expressed by
  // gamesWonA === gamesWonB; this only tracks the tied games on top.
  gamesDrawn  Int         @default(0)
  result      MatchResult @default(PENDING)
  reportedAt  DateTime?

  round    Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  entrantA Entrant  @relation("MatchEntrantA", fields: [entrantAId], references: [id], onDelete: Cascade)
  entrantB Entrant? @relation("MatchEntrantB", fields: [entrantBId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([entrantAId])
  @@index([entrantBId])
}

// ---------------------------------------------------------------------------
// Value tracking
// ---------------------------------------------------------------------------

model CardPull {
  id         String   @id @default(cuid())
  podId      String
  playerId   String?
  // True when playerId was set by the auto-inference heuristic (top-3
  // finisher <-> top-3 priciest pull, both above the threshold) and not
  // yet reviewed by a human. Sticky false once a human sets/confirms the
  // attribution — inference never overwrites a human's call.
  playerIdInferred Boolean @default(false)
  cardName   String
  scryfallId String?
  setCode    String?
  // Reflects the finish the stored priceEur actually came from, which may
  // differ from what was requested when a print doesn't have that finish
  // (see scryfall.ts's resolvePrice) — never trust this as "what the
  // organizer typed," it's "what price this actually is."
  foil       Boolean  @default(false)
  priceEur   Decimal? @db.Decimal(10, 2)
  imageUri   String?
  addedAt    DateTime @default(now())

  pod    Pod     @relation(fields: [podId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([podId])
}
