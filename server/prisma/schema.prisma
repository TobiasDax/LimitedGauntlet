// LimitedGauntlet data model — see PLAN.md for the full design rationale
// behind each entity before changing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // Optional password lock for the public pages (PI-27). Null = public pages
  // are open (the default). When set (argon2 hash), a visitor must enter the
  // password once to view any /o/<slug>/... page — an opt-in, off-by-default
  // exception to "public pages stay open", set only by the organizer.
  publicPasswordHash String?
  // Opt-in per org (PI-72), default off. When true, players earn "tokens" from
  // playing pods (participation + a standing bonus), organizers can hand-adjust
  // balances, and a Tokens tab / balance appear on the player pages. When false
  // the whole feature is invisible and no tokens are awarded — existing ledger
  // rows are kept (not deleted) so re-enabling restores them.
  tokensEnabled Boolean @default(false)
  createdAt DateTime @default(now())

  organizers  OrganizerAccount[]
  players     Player[]
  tournaments Tournament[]
  organizerInvites OrganizerInvite[]
  playerInvites PlayerInvite[]
  webhooks    OrganizationWebhook[]
  tokenTransactions TokenTransaction[]
}

// Outbound webhooks (PI-50): an HMAC-signed HTTP POST fired on round
// lifecycle events (round started/extended/completed, pairings posted) so an
// organizer's own automation (Home Assistant, etc.) can react — the receiver
// derives a live countdown from the endsAt each payload carries, so this
// never needs to stream continuously. An org can configure any number of
// these, each delivered independently with its own secret (revised 2026-08-26
// from a single url/secret pair on Organization, per Tobias — push the same
// events to multiple places at once). No rows = inert for this org, same
// "degrades cleanly when unconfigured" posture as SMTP/OIDC.
model OrganizationWebhook {
  id    String  @id @default(cuid())
  orgId String
  url   String
  // Intentionally NOT a one-way hash: unlike a password or API token
  // (something a caller presents that we only ever need to verify), this app
  // is the one PRESENTING this, as the HMAC key that signs every outgoing
  // request, so it has to remain readable to the server.
  secret String
  // Optional organizer-facing name ("Home Assistant", "Discord relay") to
  // tell multiple webhooks apart in Settings — purely cosmetic.
  label     String?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrganizerAccount {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  // Nullable since PI-42: an account provisioned purely via OIDC (SSO) has no
  // local password. Password login is rejected for such accounts; they can set
  // a password later from Settings to gain a second way in.
  passwordHash String?
  // Linked SSO identity (PI-42 / PI-43), provider-prefixed: `oidc:<sub>`,
  // `google:<sub>`, `discord:<id>`. Set the first time an SSO login links to (or
  // provisions) this account; subsequent logins match on this stable key even
  // if the provider email later changes. One SSO identity per account — binding
  // a different one goes through the PI-49 relink flow. Null for password-only.
  oidcSubject  String?  @unique
  authVersion  Int      @default(0)
  name         String
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiTokens    ApiToken[]
  emailChangeRequests EmailChangeRequest[]
  oidcRelinkRequests OidcSubjectRelinkRequest[]
  sentInvites  OrganizerInvite[]
  sentPlayerInvites PlayerInvite[]
  tokenTransactions TokenTransaction[]

  @@index([orgId])
}

model OidcSubjectRelinkRequest {
  id             String    @id @default(cuid())
  organizerId    String
  pendingSubject String
  email          String
  purpose        String    @default("SUBJECT_RELINK")
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organizer OrganizerAccount @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
}

// Pending co-organizer invites (PI-34). An invited address doesn't get an
// account until they open the emailed link and set their own name/password
// (accept-invite) — the same "possession of the link proves the address"
// pattern as EmailChangeRequest, just scoped to the org rather than an
// existing organizer. Roles are equal for v1: an accepted invite creates a
// full OrganizerAccount, same access as anyone else in the org.
model OrganizerInvite {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    OrganizerAccount @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Pending email-address changes (PI-28). A change is only applied after the
// organizer clicks a link sent to the NEW address, proving they control it.
// Only the token's SHA-256 hash is stored (same as ApiToken); single-use
// (usedAt) and time-limited (expiresAt).
model EmailChangeRequest {
  id          String    @id @default(cuid())
  organizerId String
  newEmail    String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  organizer OrganizerAccount @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
}

// Bearer tokens for non-browser clients (e.g. the MCP server) — acts as
// the minting organizer, identical blast radius to them being logged in,
// no more. Only the hash is stored; the plaintext is shown once at mint
// time and never again.
model ApiToken {
  id          String    @id @default(cuid())
  organizerId String
  name        String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  organizer OrganizerAccount @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
}

// ---------------------------------------------------------------------------
// Roster
// ---------------------------------------------------------------------------

model Player {
  id          String   @id @default(cuid())
  orgId       String
  // Unique within the org, case-insensitively — enforced app-layer in
  // routes/players.ts (Postgres has no portable case-insensitive unique index
  // without citext). Duplicate names would split standings and mis-attribute
  // results, so the roster UI blocks them outright.
  displayName String
  createdAt   DateTime @default(now())

  // Optional self-service login (PI-52). A plain roster entry has all three
  // null — the default. An organizer invites a player by email (PlayerInvite);
  // on accept, `email`/`passwordHash` are set and the player can log in at
  // /o/<slug>/player to check themselves into tournaments and report their own
  // match results. `authVersion` bumps on revoke, invalidating any live player
  // session — the same mechanism OrganizerAccount uses. This is a second auth
  // surface that never walls the open-by-default public pages; it only unlocks
  // the player's own write actions.
  email        String?
  passwordHash String?
  authVersion  Int      @default(0)

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tournamentPlayers TournamentPlayer[]
  teamMemberships   TeamMember[]
  entrants          Entrant[]
  cardPulls         CardPull[]
  playerInvites     PlayerInvite[]
  tokenTransactions TokenTransaction[]

  @@unique([orgId, email])
  @@index([orgId])
}

// Pending player-account invites (PI-52). Mirrors OrganizerInvite exactly,
// just bound to a Player row rather than provisioning a new account: the
// organizer picks a roster player + supplies an email, the player opens the
// link and sets a password (accept-player-invite), which fills in
// Player.email/passwordHash. Single-use (usedAt), time-limited (expiresAt),
// only the token's SHA-256 hash stored.
model PlayerInvite {
  id          String    @id @default(cuid())
  orgId       String
  playerId    String
  email       String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  player       Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  invitedBy    OrganizerAccount @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Tournament (one yearly weekend / GP)
// ---------------------------------------------------------------------------

enum TournamentStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

model Tournament {
  id        String           @id @default(cuid())
  orgId     String
  name      String
  startDate DateTime
  endDate   DateTime
  location  String?
  // Free-text blurb shown on the tournament page + its public link. May
  // contain URLs / [label](url) links (e.g. to Outline pages); rendered
  // safely as text-plus-links on the client, never as raw HTML.
  description String?
  status    TournamentStatus @default(PLANNING)
  // Default token rewards for this tournament's pods (PI-72; only in effect when
  // Organization.tokensEnabled). `tokenParticipation` is the flat award for
  // playing in a pod; `tokenStandingBonuses` is a JSON array of
  // { fromPlace, toPlace, tokens } rows — a player's finishing place gets the
  // tokens of the first row that contains it. A pod can override either
  // (Pod.tokenParticipation / Pod.tokenStandingBonuses; null = inherit here).
  tokenParticipation   Int  @default(0)
  tokenStandingBonuses Json?
  // PI-82: once an organizer has used PI-76's manual pod reorder, the pod
  // list stops auto-resorting by scheduled date/time on every pod
  // create/edit — sequenceOrder becomes purely organizer-controlled from
  // that point on. False (auto-sort by date/time) until the reorder endpoint
  // is used for real.
  podsManuallyReordered Boolean @default(false)
  createdAt DateTime         @default(now())

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  players      TournamentPlayer[]
  pods         Pod[]

  @@index([orgId])
}

model TournamentPlayer {
  tournamentId String
  playerId     String

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([tournamentId, playerId])
}

// ---------------------------------------------------------------------------
// Pod (one session: Freitag, Samstag 1, Chaosdraft, ...)
// ---------------------------------------------------------------------------

enum PodFormat {
  DRAFT
  SEALED
  CHAOS_DRAFT
  CONSTRUCTED
  CUSTOM
}

enum ConstructedFormat {
  STANDARD
  MODERN
  LEGACY
  VINTAGE
  PIONEER
  PRE_MODERN
  PAUPER
  CUSTOM
}

enum MatchFormat {
  BO1
  BO3
}

enum PodStatus {
  SETUP
  PAIRING
  IN_PROGRESS
  COMPLETED
}

model Pod {
  id                 String      @id @default(cuid())
  tournamentId       String
  name               String
  date               DateTime?
  format             PodFormat
  // Default Scryfall set code for this pod's card pulls (e.g. "eoe") —
  // pre-fills the add-pull form's set picker so a whole draft/sealed pod's
  // worth of pulls don't each need the set typed in by hand. Purely a
  // frontend convenience; never used server-side to resolve a pull, and
  // always overridable per pull (e.g. a bonus-sheet card from a linked
  // companion set).
  setCode            String?
  // Which constructed format was played — only meaningful when
  // format === CONSTRUCTED. CUSTOM pairs with constructedFormatCustom
  // for a free-text name (e.g. "Canadian Highlander"); application-layer
  // enforced, same pattern as setCode above.
  constructedFormat       ConstructedFormat?
  constructedFormatCustom String?
  sequenceOrder           Int
  isTeamEvent        Boolean     @default(false)
  teamSize           Int?
  roundCount         Int         @default(3)
  matchFormat        MatchFormat @default(BO3)
  pointsWin          Int         @default(3)
  pointsDraw         Int         @default(1)
  pointsLoss         Int         @default(0)
  roundLengthMinutes Int         @default(50)
  packConfig         String?
  rarepicUrl         String?
  status             PodStatus   @default(SETUP)
  excludeFromStats   Boolean     @default(false)
  // PI-66: "rare picks" / card-value tracking for this pod. When false, the
  // pod's Value tab is hidden, no card pulls can be added by any route, and
  // the pod is excluded from every value rollup (tournament Best Pulls, org
  // Treasure Chest, Hall-of-Fame value stats). Existing pulls are kept, not
  // deleted — flipping it back on restores them. Distinct from
  // excludeFromStats, which only affects standings/HoF aggregates.
  rarePicksEnabled   Boolean     @default(true)
  // Per-pod opt-out for the org's webhook (PI-50) — default on, mirrors
  // excludeFromStats's opt-out shape (an organizer turns individual noisy/
  // test pods off, rather than needing to opt each real pod in).
  webhookEnabled     Boolean     @default(true)
  // At most one pod per tournament may be the "main event" (Chaos Draft
  // for this group, but deliberately generic — any format works). Winning
  // one earns a crown on the Hall of Fame. Application-layer enforcement
  // (podRoutes unsets any sibling in a transaction before setting this)
  // plus a DB-level partial unique index (see the migration) as the real
  // guarantee — the app-layer check alone can't rule out a race.
  isMainEvent        Boolean     @default(false)
  // Standalone pre-round timer (PI-33) for draft / deck-building time, before
  // any round is paired. `prepTimerEndsAt` is when it expires (null = no timer
  // running); `prepTimerLabel` is an optional caption ("Draft", "Deck-building").
  // Independent of the per-round timer (Round.endsAt) — a pod can run this with
  // zero rounds. Only the end time is stored; the countdown ticks client-side.
  prepTimerEndsAt    DateTime?
  prepTimerLabel     String?
  // Per-pod override of the tournament's token rewards (PI-72). Null on either
  // = inherit Tournament.tokenParticipation / .tokenStandingBonuses. Only in
  // effect when Organization.tokensEnabled.
  tokenParticipation   Int?
  tokenStandingBonuses Json?
  // When this pod's last configured round completed (PI-77) — null while
  // unfinished. Drives the pod-list finished/unfinished partition and the
  // finished group's completion-order sort. Stamped/cleared by
  // syncPodTokenAwards (services/tokens.ts), the one existing hook already
  // wired into everything that can flip a pod's completion state — kept
  // independent of Organization.tokensEnabled, unlike the token awards
  // syncPodTokenAwards otherwise computes.
  completedAt        DateTime?
  // Set when an organizer cancels this pod (PI-84) instead of it finishing
  // normally — an event was called off, not played out. Presence (not a
  // boolean) doubles as the finished-area sort key alongside completedAt.
  // Canceling also sets excludeFromStats = true and is additionally checked
  // by syncPodTokenAwards, which does not otherwise look at excludeFromStats.
  canceledAt         DateTime?
  // Explicit opt-in flag (PI-81): every pod is "Scheduled" unless the
  // organizer marks it on-demand — a spontaneous pod not part of the
  // planned schedule. Independent of `date`/`startTime` being set.
  isOnDemand         Boolean     @default(false)
  // Optional scheduled start time (PI-82), "HH:MM" 24h, alongside the
  // existing date-only `date`. Kept as a separate nullable field rather than
  // widening `date` to a timestamp so date and time stay independently
  // optional (a pod can have a known day with "time TBD").
  startTime          String?
  // The moment round 1's Match rows were first created (PI-82) — i.e. seatings
  // generated / pairing started — regardless of format. Distinct from the
  // *scheduled* date/startTime above; this is real, not planned. Cleared back
  // to null if round 1 is later undone (PI-56's "Undo pairing").
  actualStartedAt    DateTime?
  createdAt          DateTime    @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams      Team[]
  entrants   Entrant[]
  rounds     Round[]
  cardPulls  CardPull[]
  tokenTransactions TokenTransaction[]

  @@index([tournamentId])
}

model Team {
  id    String @id @default(cuid())
  podId String
  name  String

  pod     Pod          @relation(fields: [podId], references: [id], onDelete: Cascade)
  members TeamMember[]
  entrant Entrant?

  @@index([podId])
}

model TeamMember {
  teamId   String
  playerId String

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
}

// Entrant unifies individual players and ad-hoc teams as "the thing that
// gets paired" so standings/pairing logic doesn't need separate code paths
// for 1v1 vs team pods. Exactly one of playerId/teamId is set, matching
// Pod.isTeamEvent — enforced at the application layer (Prisma has no
// portable CHECK-constraint-style XOR).
model Entrant {
  id                  String  @id @default(cuid())
  podId               String
  playerId            String?
  teamId              String? @unique
  // N = played through round N, excluded from pairing in round N+1 onward
  // (see getActiveEntrants in pairing.ts); null = never dropped. Set via
  // POST /api/entrants/:id/drop, cleared via .../undrop (PI-63) — both only
  // allowed between rounds, never while one is ACTIVE/PENDING, so there's
  // never an in-flight match to rewrite when a drop is recorded.
  droppedAfterRound   Int?
  // Set only by the history-import script, for pods whose source data is a
  // final standings table with no round-by-round detail (most pre-2026
  // Outline docs). When present, standings computation reports this value
  // directly instead of deriving points from Match rows — deliberately not
  // fabricating pairings that were never recorded. Tiebreakers (OMW%/GW%/
  // OGW%) report as 0 for these entrants since no match data exists to
  // compute them from.
  finalPointsOverride Int?
  // Manual tiebreak order, only ever compared between entrants who are
  // ALREADY tied on points — never overrides points itself. Exists for the
  // "intentional draw to lock in placement" case: two players draw their
  // final match on purpose (e.g. 2W-1D = 7 points, safely clear of 3rd
  // place's 6), and the computed OMW%/GW%/OGW% tiebreakers among a small
  // pod don't necessarily reflect what the group actually decided —
  // sometimes there's nothing to compute a "real" order from at all. Lower
  // sorts first. Set via the standings page's reorder-within-a-tie UI.
  manualTiebreak      Int?

  pod        Pod     @relation(fields: [podId], references: [id], onDelete: Cascade)
  player     Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team       Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchesAsA Match[] @relation("MatchEntrantA")
  matchesAsB Match[] @relation("MatchEntrantB")

  @@index([podId])
  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Rounds & matches
// ---------------------------------------------------------------------------

enum RoundStatus {
  PENDING
  ACTIVE
  COMPLETED
}

model Round {
  id          String      @id @default(cuid())
  podId       String
  roundNumber Int
  startedAt   DateTime?
  endsAt      DateTime?
  status      RoundStatus @default(PENDING)

  pod     Pod     @relation(fields: [podId], references: [id], onDelete: Cascade)
  matches Match[]

  @@unique([podId, roundNumber])
}

enum MatchResult {
  PENDING
  A_WINS
  B_WINS
  DRAW
}

model Match {
  id          String      @id @default(cuid())
  roundId     String
  tableNumber Int
  entrantAId  String
  entrantBId  String? // null = bye
  gamesWonA   Int         @default(0)
  gamesWonB   Int         @default(0)
  // Games that were themselves drawn (e.g. a Bo3 that ends 1-1-1, or a
  // single game timing out unfinished). Not credited to either side, but
  // counted as games played — so game-win% is diluted the way the MTR/
  // larger-tournament rules intend. A match DRAW is still expressed by
  // gamesWonA === gamesWonB; this only tracks the tied games on top.
  gamesDrawn  Int         @default(0)
  result      MatchResult @default(PENDING)
  reportedAt  DateTime?

  round    Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  entrantA Entrant  @relation("MatchEntrantA", fields: [entrantAId], references: [id], onDelete: Cascade)
  entrantB Entrant? @relation("MatchEntrantB", fields: [entrantBId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([entrantAId])
  @@index([entrantBId])
}

// ---------------------------------------------------------------------------
// Value tracking
// ---------------------------------------------------------------------------

model CardPull {
  id         String   @id @default(cuid())
  podId      String
  playerId   String?
  // True when playerId was set by the auto-inference heuristic (top-3
  // finisher <-> top-3 priciest pull, both above the threshold) and not
  // yet reviewed by a human. Sticky false once a human sets/confirms the
  // attribution — inference never overwrites a human's call.
  playerIdInferred Boolean @default(false)
  cardName   String
  scryfallId String?
  setCode    String?
  // Reflects the finish the stored priceEur actually came from, which may
  // differ from what was requested when a print doesn't have that finish
  // (see scryfall.ts's resolvePrice) — never trust this as "what the
  // organizer typed," it's "what price this actually is."
  foil       Boolean  @default(false)
  priceEur   Decimal? @db.Decimal(10, 2)
  imageUri   String?
  addedAt    DateTime @default(now())

  pod    Pod     @relation(fields: [podId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([podId])
}

// ---------------------------------------------------------------------------
// Tokens (PI-72) — an opt-in per-org player currency (Organization.tokensEnabled)
// ---------------------------------------------------------------------------

enum TokenTxnReason {
  POD_PARTICIPATION // auto: played in a pod
  POD_STANDING      // auto: finishing-place bonus
  MANUAL            // organizer add / deduct / "set balance to X"
  INITIAL           // organizer seeding a balance from external history
}

// Append-only ledger. A player's balance is SUM(delta). The two POD_* reasons
// are recomputed by syncPodTokenAwards whenever a pod's standings or completion
// state changes (deleted + recreated for that podId); MANUAL/INITIAL rows are
// only ever created, never touched by automation.
model TokenTransaction {
  id          String         @id @default(cuid())
  orgId       String
  playerId    String
  delta       Int
  reason      TokenTxnReason
  note        String?
  podId       String?
  createdById String?
  createdAt   DateTime       @default(now())

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  player       Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  pod          Pod?              @relation(fields: [podId], references: [id], onDelete: Cascade)
  createdBy    OrganizerAccount? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, playerId])
  @@index([podId])
}
