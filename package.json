{
  "name": "limited-gauntlet",
  "version": "0.12.0",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "mcp"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "hono": "^4.13.7",
    "qs": "^6.16.0"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && npm run build --workspace server && npm run build --workspace mcp",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.70.0",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
